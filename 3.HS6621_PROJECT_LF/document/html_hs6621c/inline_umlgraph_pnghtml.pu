@startuml inline_umlgraph_1.png
repeat :Start
partition Event Scheduler {
    :Event scheduler: call rwip_schedule();
}
partition Power Manager {
    :Enter critical ke_event_set;
    if (Is there any event of ke_event_set here ?) then (No)
        if (Is RF of BLE running ?) then (No)
            :Check user power status;
            note
            Default callback is
            pmu_power_status(),
            Register a new through
            co_power_register_user_status()
            end note
        else (Yes)
        endif
        partition Sleep Flow {
            if (Is POWER_IDLE ?) then (Yes)
                :Call __WFI();
            else (No)
                :Notify user: enter sleep;
                note
                Register callback through
                co_power_register_sleep_event()

                POWER_SLEEP_ENTRY
                end note
                :Lock the output state of all IO;
                :Sleep;
                :Notify user: leave sleep (top half);
                note: POWER_SLEEP_LEAVE_TOP_HALF
                :Unlock the output state of all IO;
                :Notify user: leave sleep (bottom half);
                note: POWER_SLEEP_LEAVE_BOTTOM_HALF
            endif
        }
    else (Yes)
    endif
    :Leave critical section;
}
repeat while
@enduml

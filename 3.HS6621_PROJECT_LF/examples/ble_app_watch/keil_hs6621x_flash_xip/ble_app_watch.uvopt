          <Filename>..\..\common\app_task.c</Filename>
          <ExecCommand></ExecCommand>
          <Expression>\\ble_app_watch\../../common/app_task.c\748</Expression>
        </Bp>
      </Breakpoint>
      <WatchWindow1>
        <Ww>

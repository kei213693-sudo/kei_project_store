{
    // ================== 代码格式化 ==================
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.formatOnSave": true,                   // 保存时自动格式化
        "editor.formatOnType": true,                   // 输入时自动格式化（如括号补全）
        "editor.formatOnPaste": true                   // 粘贴时自动格式化
    },
    "python.formatting.provider": "yapf",              // 选择格式化工具为yapf
    "python.formatting.yapfArgs": [                    // 自定义 yapf 参数
        "--style",
        "{based_on_style: pep8, column_limit: 248}"
    ],
    "isort.args": [//与 yapf 兼容
        "--profile", "black",
        "--line-length", "248"  // 保持与yapf、flake8行长度一致
    ],              


    // ================== 代码检查 ==================
    "python.linting.enabled": true,                  // 启用 linting
    "python.linting.flake8Enabled": true,            // 使用 flake8 检查
    "python.linting.flake8Args": [
        "--ignore=E203,W503,F401",// 忽略特定错误码
        "--max-line-length=248"// 行长度限制
    ],
    "python.linting.mypyEnabled": true,              // 启用类型检查
    "python.linting.mypyArgs": [
        "--strict",// 严格类型检查
        "--ignore-missing-imports"// 忽略缺失的导入
    ],
    "python.linting.pylintEnabled": false,           // 禁用 pylint


    // ================== 自动补全与类型提示 ==================
    "python.analysis.typeCheckingMode": "basic",     // 类型检查严格度（off|basic|strict）
    "python.analysis.autoImportCompletions": true,   // 自动导入建议
    "python.analysis.autoSearchPaths": true,         // 自动搜索导入路径
    "editor.suggestSelection": "first",              // 自动选择第一个建议项
    "editor.snippetSuggestions": "top",              // 代码片段建议显示在顶部
    "editor.suggest.snippetsPreventQuickSuggestions": false, // 智能补全时不阻止快速建议


    // ================== 虚拟环境 ==================
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",  // Windows
    "python.terminal.activateEnvironment": true,


     // ================== 测试与调试 ==================
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests/"],
    "debug.console.closeOnEnd": true,


    // ================== 其他配置 ==================
    "files.autoSave": "afterDelay",                  //停止输入后自动触发,自动保存文件
    "files.autoSaveDelay": 1500,                     // 自动保存延时（毫秒，默认1000）   
    "editor.rulers": [124, 124, 248],                 // 显示垂直参考线（提醒行长度限制）
    "editor.wordWrap": "on",                         // 自动换行
    //"editor.minimap.enabled": false,               // 禁用右上角小地图
}
